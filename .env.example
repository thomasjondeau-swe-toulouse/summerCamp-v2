# Modèle de fichier .env — copie-le dans chaque dossier d'application.
#
# Docker Compose lit automatiquement le fichier « .env » posé à côté du
# docker-compose.yml : plus besoin de faire « export » à chaque terminal.
#
# Pour créer les 8 fichiers d'un coup, depuis le dossier app/ :
#
#   for d in familytask corrections/step-*; do
#     echo 'AI_TOKEN=ton_jeton_github' > "$d/.env"
#   done
#
# .env est dans le .gitignore : ta clé ne partira jamais sur GitHub.
# C'est exactement sa raison d'être.
#
# Inutile dans un codespace : le secret AI_TOKEN y est déjà fourni par GitHub.

AI_TOKEN=colle_ici_ton_jeton_github
